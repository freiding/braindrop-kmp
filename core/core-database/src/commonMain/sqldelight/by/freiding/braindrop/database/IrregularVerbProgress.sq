CREATE TABLE IrregularVerbProgress (
    verb_id TEXT NOT NULL PRIMARY KEY,
    is_learned INTEGER NOT NULL DEFAULT 0,
    times_correct INTEGER NOT NULL DEFAULT 0,
    times_incorrect INTEGER NOT NULL DEFAULT 0,
    last_studied_at INTEGER
);

getAll:
SELECT * FROM IrregularVerbProgress;

getByVerbId:
SELECT * FROM IrregularVerbProgress WHERE verb_id = ?;

countLearned:
SELECT COUNT(*) FROM IrregularVerbProgress WHERE is_learned = 1;

upsertProgress:
INSERT OR REPLACE INTO IrregularVerbProgress(verb_id, is_learned, times_correct, times_incorrect, last_studied_at)
VALUES (?, ?, ?, ?, ?);

sumCorrect:
SELECT COALESCE(SUM(times_correct), 0) FROM IrregularVerbProgress;

sumIncorrect:
SELECT COALESCE(SUM(times_incorrect), 0) FROM IrregularVerbProgress;
