-- Migrates the AppDatabase schema from v2 to v3.
--
-- Adds the ChunkProgress table backing the Vocabulary feature's spaced-repetition scheduler.
-- CREATE ... IF NOT EXISTS so the migration is a no-op on installs where Schema.create()
-- already built the current schema (same reasoning as 1.sqm shape B).

CREATE TABLE IF NOT EXISTS ChunkProgress (
    chunk_id TEXT NOT NULL PRIMARY KEY,
    box INTEGER NOT NULL DEFAULT 0,
    due_date TEXT,
    streak INTEGER NOT NULL DEFAULT 0,
    times_seen INTEGER NOT NULL DEFAULT 0,
    times_correct INTEGER NOT NULL DEFAULT 0,
    last_reviewed_at INTEGER,
    is_learned INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS chunkprogress_due_date ON ChunkProgress(due_date);
