    <!-- Aspect semantics: shared across TensesListScreen, TenseDetailScreen, TenseCheatSheetScreen -->
    <string name="tense_aspect_simple_label">ФАКТ</string>
    <string name="tense_aspect_simple_description">Simple — это факт, привычка или законченное действие. Не важен ни процесс, ни результат «здесь и сейчас» — просто что происходит, происходило или произойдёт.</string>
    <string name="tense_aspect_continuous_label">ПРОЦЕСС</string>
    <string name="tense_aspect_continuous_description">Continuous — это процесс в развитии. Важно, что действие происходит, происходило или будет происходить в конкретный момент, а не то, чем оно закончилось.</string>
    <string name="tense_aspect_perfect_label">РЕЗУЛЬТАТ</string>
    <string name="tense_aspect_perfect_description">Perfect — это результат к моменту. Важна связь между двумя точками во времени и сам факт завершения действия, а не то, сколько оно длилось.</string>
    <string name="tense_aspect_perfect_continuous_label">ДЛИТЕЛЬНОСТЬ</string>
    <string name="tense_aspect_perfect_continuous_description">Perfect Continuous — это длительность процесса вплоть до момента. Важно, сколько действие уже длится, длилось или будет длиться, а не факт его завершения.</string>

